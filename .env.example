# ==============================================================================
# LOGINTEL — Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME=LogIntel
VERSION=1.0.0

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker / SQLite in local standalone)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logintel
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logintel
# Fallback SQLite for instant zero-dependency local dev:
# DATABASE_URL=sqlite:///./logintel.db

# OpenSearch Configuration
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=logintel-logs

# Syslog Receiver
SYSLOG_UDP_PORT=5140
SYSLOG_ENABLED=true

# Frontend Port & URLs
VITE_API_BASE_URL=http://localhost:8000/api
