# ==============================================================================
# LOGINTEL — Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' on the production host and populate with strong secrets:
#   cp .env.production.example .env
#   chmod 600 .env
#
# Generate cryptographically secure keys with:
#   openssl rand -hex 32
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME=LogIntel
VERSION=1.0.0

# Security & JWT (MANDATORY: Generate a unique random string with openssl rand -hex 32)
SECRET_KEY=GENERATE_SECURE_RANDOM_SECRET_KEY_HERE_MIN_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Credentials (MANDATORY: Use a strong unique password)
POSTGRES_USER=logintel_prod_admin
POSTGRES_PASSWORD=GENERATE_SECURE_DB_PASSWORD_HERE
POSTGRES_DB=logintel_prod

# OpenSearch Cluster Settings (Internal Container Mesh)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=logintel-logs

# Syslog Ingestion Listener
SYSLOG_UDP_PORT=5140
SYSLOG_ENABLED=true

# Production Domain & CORS Allowlist
# Replace with your production domain / server IP (e.g. https://logintel.yourdomain.com)
PRODUCTION_CORS_ORIGINS=https://logintel.yourdomain.com,http://YOUR_SERVER_PUBLIC_IP

# Frontend Relative API URL for Nginx Reverse Proxy (Keep as '/api' in production)
VITE_API_BASE_URL=/api
